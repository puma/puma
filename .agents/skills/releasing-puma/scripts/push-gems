#!/usr/bin/env bash
set -euo pipefail

[ $# -gt 1 ] || { echo "usage: GEM_HOST_API_KEY=... push-gems TAG GEM..." >&2; exit 1; }
tag=$1; shift
[ -n "${GEM_HOST_API_KEY:-}" ] || { echo "GEM_HOST_API_KEY is not set" >&2; exit 1; }

remote=$(git ls-remote --tags origin "refs/tags/$tag" | cut -f1)
[ -n "$remote" ] && [ "$remote" = "$(git rev-parse "refs/tags/$tag")" ] ||
  { echo "$tag is missing on origin or differs from the local tag" >&2; exit 1; }
git tag -v "$tag" >/dev/null 2>&1 || { echo "$tag is not a signed tag with a valid signature" >&2; exit 1; }
"$(dirname "$0")/check-gems" "$tag" "$@"

status=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: $GEM_HOST_API_KEY" https://rubygems.org/api/v1/gems.json)
[ "$status" = 200 ] || { echo "RubyGems rejected GEM_HOST_API_KEY (HTTP $status)" >&2; exit 1; }

read -rp "RubyGems OTP: " GEM_HOST_OTP_CODE
export GEM_HOST_OTP_CODE

for gem in "$@"; do
  gem push "$gem"
done
