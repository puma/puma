#!/usr/bin/env bash
set -euo pipefail

RUBY_IMAGE=ruby:4.0@sha256:a69f361db050bb2c65ec66ef75411bfc4ce2e1d993ba1179fac4e4ba6ecfe91f
JRUBY_IMAGE=jruby:10.1.3.0-jdk21@sha256:40b63556cb55b72d6ff734c052482a3950db7253b5964b82d3e8ab345c1536d1

[ $# -eq 1 ] || { echo "usage: build-gems REF" >&2; exit 1; }
scripts=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel)
sha=$(git -C "$root" rev-parse --verify "$1^{commit}")
src=$root/tmp/release/build-$sha

rm -rf "$src"
git clone -q --no-checkout "$root" "$src"
git -C "$src" checkout -q --detach "$sha"
touch "$src/ext/puma_http11/http11_parser.c" "$src/ext/puma_http11/org/jruby/puma/Http11Parser.java"

run() {
  docker run --rm -v "$src:/puma" -v "$scripts:/scripts:ro" -w /puma \
    -e SOURCE_DATE_EPOCH="$(git -C "$src" log -1 --format=%ct)" -e PUMA_NO_RUBOCOP=true \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*' \
    "$@"
}

run "$JRUBY_IMAGE" sh -ec '
  apt-get update -qq && apt-get install -qq -y --no-install-recommends git build-essential >/dev/null
  bundle install --quiet && bundle exec rake compile
  date=$(date -u -d "@$SOURCE_DATE_EPOCH" +%FT%TZ)
  for jar in tmp/java/puma_http11/puma_http11.jar lib/puma/puma_http11.jar; do
    classes=$(mktemp -d) && (cd "$classes" && jar xf "/puma/$jar")
    rm "$jar" && (cd "$classes" && find . -type f | sed s,^./,, | LC_ALL=C sort |
      xargs jar --create --file "/puma/$jar" --no-manifest --date="$date")
  done
  cd /puma && bundle exec rake java gem'
run "$RUBY_IMAGE" sh -ec 'rm -f Gemfile.lock && bundle install --quiet && bundle exec rake build'
run "$RUBY_IMAGE" sh -ec "
  /scripts/check-gems $sha pkg/*.gem
  cd pkg && sha256sum *.gem > SHA256SUMS
  chown -R $(id -u):$(id -g) /puma"

echo "gems and SHA256SUMS are in $src/pkg"
